log_format waf_json escape=json '{'
    '"time":"$time_iso8601",'
    '"request_id":"$request_id",'
    '"remote_addr":"$remote_addr",'
    '"host":"$host",'
    '"method":"$request_method",'
    '"request_uri":"$request_uri",'
    '"status":$status,'
    '"bytes_sent":$bytes_sent,'
    '"request_time":$request_time,'
    '"upstream_time":"$upstream_response_time",'
    '"upstream_status":"$upstream_status",'
    '"user_agent":"$http_user_agent"'
'}';

# Minimal, query-free correlation evidence shared with the networkless
# telemetry sidecar. The request ID is also the ModSecurity transaction ID.
log_format waf_correlation escape=json '{'
    '"time":"$time_iso8601",'
    '"request_id":"$request_id",'
    '"remote_addr":"$remote_addr",'
    '"host":"$host",'
    '"method":"$request_method",'
    '"uri":"$uri",'
    '"status":$status,'
    '"upstream_status":"$upstream_status"'
'}';

access_log ${ACCESSLOG} waf_json;
access_log ${WAF_CORRELATION_LOG} waf_correlation;
error_log ${ERRORLOG} ${LOGLEVEL};
